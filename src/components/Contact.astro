---
import ButtonIcon from "./ButtonIcon.astro";
import type { Lang } from "@/i18n/translations";
import { t } from "@/i18n/translations";

interface Props {
  lang?: Lang;
}

const { lang = "ar" } = Astro.props;
const tr = t(lang);
---

<section class="full-width bg-[#191925] text-light" id="contact">
  <div class="flex flex-col items-center justify-center text-center gap-6 max-w-[1200px] mx-auto px-4 sm:px-8 lg:px-16 xl:px-32 py-24 sm:py-32">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold leading-tight">
      {tr.contact.headline}
    </h2>

    <p class="text-slate-300 leading-relaxed text-lg max-w-lg">
      {tr.contact.subheadline}
    </p>

    <a
      href="mailto:fmorenilla23@gmail.com"
      class="group text-slate-400 hover:text-accent transition-colors duration-200 text-base underline underline-offset-4 decoration-slate-700 group-hover:decoration-accent"
    >
      fmorenilla23@gmail.com
    </a>

    <div class="flex flex-wrap gap-3 justify-center mt-2">
      <ButtonIcon
        isBlank
        iconName="pdf"
        url={tr.contact.cvUrl}
        borderColor="var(--color-primary)"
        name={tr.contact.cv}
      />
    </div>
  </div>
</section>
