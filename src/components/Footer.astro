---
import { Icon } from "astro-icon/components";
import type { Lang } from "@/i18n/translations";
import { t } from "@/i18n/translations";

interface Props {
	lang?: Lang;
}

const { lang = "ar" } = Astro.props;
const tr = t(lang);
const currentYear = new Date().getFullYear();

const socials = [
	{
		href: tr.contact.cvUrl,
		icon: "pdf",
		label: "CV",
	},
	{
		href: "https://www.linkedin.com/in/muhmaedabdelaziem/",
		icon: "linkedin",
		label: "LinkedIn",
	},
	{
		href: "https://github.com/muhmed-abdelaziem",
		icon: "github",
		label: "GitHub",
	},
];
---

<footer class="relative z-10 bg-[#171e2d] text-light border-t border-slate-800">
	<div
		class="relative max-w-[1200px] mx-auto p-4 z-10 flex flex-col sm:flex-row items-center justify-between gap-4"
	>
		<p class="text-slate-400 text-sm order-2 sm:order-1">
			Mohamed Abdelaziem &copy; {currentYear}
		</p>
		<div class="flex items-center gap-4 order-1 sm:order-2">
			{
				socials.map(({ href, icon, label }) => (
					<a
						href={href}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={label}
						class="text-slate-500 hover:text-[var(--color-primary)] transition-colors duration-200"
					>
						<Icon name={icon} class="w-4 h-4" />
					</a>
				))
			}
		</div>

		<p class="text-slate-600 text-xs order-3">
			{tr.footer.builtWith}
			<a
				href="https://astro.build/"
				target="_blank"
				rel="noopener noreferrer"
				class="text-slate-500 hover:text-[var(--color-primary)] transition-colors"
				>Astro</a
			>
			{tr.footer.and}
			<a
				href="https://tailwindcss.com/"
				target="_blank"
				rel="noopener noreferrer"
				class="text-slate-500 hover:text-[var(--color-primary)] transition-colors"
				>Tailwind</a
			>
		</p>
	</div>
</footer>
