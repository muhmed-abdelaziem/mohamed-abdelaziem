---
import ButtonIcon from "@/components/ButtonIcon.astro";
import Badge from "@/components/Badge.astro";
import { Icon } from "astro-icon/components";
import type { Lang } from "@/i18n/translations";
import { t } from "@/i18n/translations";

interface Props {
	lang?: Lang;
}

const { lang = 'ar' } = Astro.props;
const tr = t(lang);
---

<section class="flex flex-row full-width h-screen bg-gradient-to-t to-[#282828] from-[#191925] text-light" id="home">
	<div class="relative flex flex-col items-center justify-center mx-auto h-full p-4 max-w-[1200px] text-center gap-y-4 z-10">
		<!-- الهيكل (HTML) -->
<div class="avatar-wrapper">
  <div class="avatar-circle">
    <img src="/img/my-photo.png" alt="Mohamed Abdelaziem" class="avatar-img" />
  </div>
</div>
		
		<Badge>{tr.hero.role}</Badge>
		<p class="font-light text-sm sm:text-base">{tr.hero.greeting}</p>
		<h1 class="text-4xl sm:text-5xl md:text-6xl">{tr.hero.name}</h1>
		<p class="font-light text-base text-slate-300 lg:text-lg leading-7.5 px-2 max-w-lg">
			<span class="whitespace-nowrap"><strong>{tr.hero.role}</strong></span> <span class="text-accent font-[400] whitespace-nowrap">{tr.hero.years}</span>{tr.hero.description}
		</p>
		<div class="flex gap-x-2.5 mb-2">
			<ButtonIcon name="CV" url={tr.contact.cvUrl} iconName="pdf" isBlank animated />
			<ButtonIcon name="LinkedIn" url="https://www.linkedin.com/in/muhmaedabdelaziem/" iconName="linkedin" isBlank animated />
			<ButtonIcon name="Github" url="https://github.com/muhmed-abdelaziem" iconName="github" isBlank animated />
		</div>
		<a class="absolute bottom-[-30px] left-1/2 transform -translate-x-1/2" href="#about" aria-label={tr.hero.ariaDown}>
			<Icon
				name="arrow-down"
				class="text-5xl mt-4 text-gray-600 cursor-pointer animate-bounce duration-500 hover:text-gray-200"
				aria-label={tr.hero.ariaDown}
			/>
		</a>
	</div>
</section>